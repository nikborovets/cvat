# Copy to .env and adjust for your machine:
#   cp .env.example .env

# Public CVAT hostname (Traefik, CVAT_BASE_URL, CSRF_TRUSTED_ORIGINS)
CVAT_HOST=localhost

# Optional UI plugins (see docker-compose.dev.yml)
# CLIENT_PLUGINS=plugins/sam2

# Host path bind-mounted as /home/django/share (docker-compose.data-mount.yml)
CVAT_SHARE_MOUNT_PATH=/path/to/cvat_share_mount

# Traefik trusted reverse-proxy IPs/CIDRs (docker-compose.proxy-trust.local.yml)
# Add your external reverse-proxy IP if CVAT is behind one.
TRAEFIK_TRUSTED_PROXY_IPS=127.0.0.1/32,172.16.0.0/12,10.0.0.0/8,192.168.0.0/16
